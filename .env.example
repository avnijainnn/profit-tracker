# Documentation only; configure these in the hosting dashboard.
# Render supplies RENDER_EXTERNAL_HOSTNAME for automatic hosts/CSRF configuration.
APP_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_NEON_HOST/DBNAME?sslmode=require
DATABASE_SSL_REQUIRE=true
TRUST_PROXY_HTTPS=true
WEB_CONCURRENCY=1
ENABLE_PASSWORD_RESET=false
INITIAL_OWNER_USERNAME=owner
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Share the resulting private setup link only with the intended account owner.
INITIAL_OWNER_SETUP_TOKEN=GENERATE_A_RANDOM_ONE_TIME_SETUP_TOKEN_AT_LEAST_32_CHARACTERS
DEMO_SEED_DATA=false
# For another host or a custom domain, set explicit comma-separated values:
# DJANGO_ALLOWED_HOSTS=your.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your.example.com
# Local development photo directory; production stores photos in PostgreSQL.
# PRODUCT_MEDIA_ROOT=/var/lib/profit-studio/media
